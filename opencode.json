{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "*": "ask",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "edit": {
      "*": "allow",
      "topics/*/human/*": "deny",
      "tools/*": "deny",
      "templates/*": "deny",
      ".opencode/*": "deny",
      "AGENTS.md": "deny",
      "opencode.json": "deny"
    },
    "bash": {
      "*": "ask",
      "python3 tools/*": "allow",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "*human/*": "deny"
    },
    "webfetch": "ask"
  }
}
